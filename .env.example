# App
NODE_ENV=
# debug | info | warn | error | silent (defaults to info)
LOG_LEVEL=

# API
API_PORT=
VITE_API_URL=

# Client
CLIENT_URL=

# Auth (generate a 32+ char secret, e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Database: set POSTGRES_URL, or all of the POSTGRES_* keys below it.
# POSTGRES_URL wins when both are set. Leave unused keys empty.
POSTGRES_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_NAME=

# Queue: set REDIS_URL, or REDIS_HOST, REDIS_PORT and REDIS_PASSWORD.
# REDIS_URL wins when both are set. Leave unused keys empty.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
RATE_LIMIT_KEY_SECRET=
TRUST_PROXY=false
QUEUE_CONCURRENCY=5
QUEUE_BACKLOG_THRESHOLD=100

# Mail
RESEND_API_KEY=
MAIL_DOMAIN=
MAIL_RATE_LIMIT_PER_SECOND=2

# Skool scraping
# true lets e2e tests script what Skool returns; unscripted searches still reach Skool
SKOOL_SCRIPTING=false

# AI filter (stage 2) — required, the server will not start without it
OPENAI_API_KEY=
AI_FILTER_MODEL=gpt-5-mini
# Leads sent to OpenAI at once (1-64); raise it as your OpenAI usage tier allows
AI_FILTER_CONCURRENCY=12

# Web search (stage 3) — required, the server will not start without it
TAVILY_API_KEY=
# Leads searched on Tavily at once (1-32)
ENRICH_CONCURRENCY=5

# Error monitoring (Sentry-compatible, e.g. Bugsink) — optional, leave empty to disable
SENTRY_DSN=
VITE_SENTRY_DSN=


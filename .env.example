# App
NODE_ENV=

# API
API_PORT=
VITE_API_URL=

# Client
CLIENT_URL=
NEXT_PUBLIC_CLIENT_URL=
NEXT_PUBLIC_SITE_URL=
VITE_LP_URL=

# Auth (generate a 32+ char secret, e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Database
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_NAME=

# Queue
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
RATE_LIMIT_KEY_SECRET=
TRUST_PROXY=false
QUEUE_CONCURRENCY=5
QUEUE_BACKLOG_THRESHOLD=100

# S3
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=

# Mail
RESEND_API_KEY=
MAIL_DOMAIN=
MAIL_RATE_LIMIT_PER_SECOND=2

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Embeddings
OPENAI_API_KEY=

# Error monitoring (Sentry-compatible, e.g. Bugsink) — optional, leave empty to disable
SENTRY_DSN=

# Analytics (Umami — @repo/front)
# Self-hosted or Umami Cloud tracker. SRC is the full script.js URL,
# WEBSITE_ID is the site UUID, DOMAINS is a comma-separated allowlist of
# hostnames Umami will track on (keeps localhost/preview traffic out).
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=

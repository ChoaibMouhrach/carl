# App
NODE_ENV=

# API
API_PORT=
VITE_API_URL=

# Client
CLIENT_URL=

# Auth (generate a 32+ char secret, e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Database
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_NAME=

# Queue
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
RATE_LIMIT_KEY_SECRET=
TRUST_PROXY=false
QUEUE_CONCURRENCY=5
QUEUE_BACKLOG_THRESHOLD=100

# Mail
RESEND_API_KEY=
MAIL_DOMAIN=
MAIL_RATE_LIMIT_PER_SECOND=2

# Error monitoring (Sentry-compatible, e.g. Bugsink) — optional, leave empty to disable
SENTRY_DSN=
VITE_SENTRY_DSN=


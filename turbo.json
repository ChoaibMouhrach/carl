{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "cache": true,
      "outputs": ["dist/**"]
    },
    "db:studio": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    },
    "check:env": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "e2e": {
      "cache": false
    },
    "e2e:gen": {
      "cache": false,
      "persistent": true
    }
  }
}

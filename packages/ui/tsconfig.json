{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@repo/ui/components": ["./src/components"],
      "@repo/ui/components/*": ["./src/components/*"],
      "@repo/ui/hooks": ["./src/hooks"],
      "@repo/ui/hooks/*": ["./src/hooks/*"],
      "@repo/ui/utils": ["./src/utils.ts"],
      "@repo/ui": ["./src"]
    }
  },
  "include": ["src"]
}

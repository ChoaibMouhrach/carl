{
  "name": "@repo/e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:gen": "playwright codegen --target=playwright-test --output=tests/_codegen.ts http://localhost:5173/app",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.0",
    "@repo/server": "workspace:*",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}

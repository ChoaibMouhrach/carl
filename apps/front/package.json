{
  "name": "@repo/front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "logo:png": "bun run scripts/generate-logo.ts",
    "og:png": "bun run scripts/generate-og.ts",
    "build": "bun run logo:png && bun run og:png && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check:env": "bun run src/config/env.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@repo/constants": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/browser": "^10.68.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-intl": "^4.3.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

{
  "name": "@repo/server",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "format": "prettier --write .",
    "test": "bun test --concurrent",
    "test:watch": "bun test --concurrent --watch",
    "typecheck": "tsc -b --noEmit",
    "check:env": "bun run src/config/env.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/saas-template",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@faker-js/faker": "^10.3.0",
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.58.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@hono/standard-validator": "^0.2.2",
    "@hono/zod-validator": "^0.7.6",
    "@repo/constants": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "format": "^0.2.2",
    "hono": "^4.12.3",
    "hono-openapi": "^1.3.0",
    "pg": "^8.18.0",
    "prettier": "^3.8.1",
    "resend": "^6.10.0",
    "stripe": "^22.3.2",
    "zod": "^4.3.6"
  }
}

{
  "name": "@repo/server",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "format": "prettier --write .",
    "test": "bun test --max-concurrency=1",
    "test:watch": "bun test --max-concurrency=1 --watch",
    "typecheck": "tsc -b --noEmit",
    "check:env": "bun run src/config/env.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/saas-template",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "email": "email dev --dir src/emails/templates --port 3001",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@faker-js/faker": "^10.3.0",
    "@react-email/ui": "6.9.1",
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "react-email": "^6.9.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.58.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@hono/standard-validator": "^0.2.2",
    "@hono/zod-validator": "^0.7.6",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@repo/constants": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.5",
    "@sentry/node": "^10.68.0",
    "better-auth": "^1.6.25",
    "bullmq": "^5.80.8",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "format": "^0.2.2",
    "hono": "^4.12.3",
    "hono-openapi": "^1.3.0",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.11.1",
    "pg": "^8.18.0",
    "prettier": "^3.8.1",
    "rate-limit-redis": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.10.0",
    "stripe": "^22.3.2",
    "zod": "^4.3.6"
  }
}
